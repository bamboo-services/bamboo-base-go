{
  "name": "bamboo-base-tooling",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint:docs": "markdownlint-cli2",
    "format:docs": "prettier --write --no-error-on-unmatched-pattern README.md \"docs/**/*.md\"",
    "format:docs:check": "prettier --check --no-error-on-unmatched-pattern README.md \"docs/**/*.md\""
  },
  "devDependencies": {
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.9"
  }
}
